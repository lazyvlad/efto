# Only used when the project folder itself is reachable from the web (sub-folder hosting on a
# shared Apache docroot). Everything is forwarded into public/, so nothing outside it - .env,
# vendor/, storage/, the game source - can be requested.
# In production the web root should point directly at public/ and this file is never read.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>
