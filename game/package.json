{
  "name": "input-game",
  "version": "3.2.0",
  "description": "I N P U T - the game front-end and its build",
  "main": "game-modular.js",
  "scripts": {
    "build": "node build.js",
    "build:dev": "node build.js --dev",
    "test": "node --test tests/",
    "assets:report": "node tools/optimize-assets.js",
    "assets:optimize": "node tools/optimize-assets.js --dir ../public/game --write",
    "clean": "node -e \"const fs = require('fs-extra'); fs.removeSync('../public/game'); fs.removeSync('dev_dist');\"",
    "boss-lab": "node tools/boss-lab.mjs"
  },
  "devDependencies": {
    "chalk": "^4.1.2",
    "clean-css": "^5.3.3",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "playwright-core": "^1.64.0",
    "readline-sync": "^1.4.10",
    "sharp": "^0.35.5",
    "terser": "^5.24.0"
  },
  "keywords": [
    "game",
    "javascript",
    "html5"
  ],
  "author": "EFTO Team",
  "license": "MIT"
}
