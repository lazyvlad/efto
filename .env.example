# Controls which game entrypoint PHP serves.
# development: serves ./index.html and source ES modules from classes/, systems/, data/, utils/, ui/
# production: serves ./dist/index.html and built/minified assets from dist/
EFTO_ENV=development

# Optional override. Usually leave empty unless you need a custom static root.
# EFTO_STATIC_ROOT=dist

# Optional. Comma-separated list of other origins allowed to call api/highscores.php from the browser.
# Leave empty when the game and the API are served from the same site (the normal setup).
# EFTO_ALLOWED_ORIGINS=https://example.com,https://www.example.com
